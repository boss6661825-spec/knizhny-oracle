
import { InlineKeyboard } from "grammy"

const predictions = {
  "🖤 Дарк-романтика": [
    "Тебя ждёт тот, кто опаснее твоих книжных крашей. И да, он уже одержим.",
    "Сегодня не игнорируй красные флаги. Хотя кого мы обманываем? Ты их коллекционируешь.",
    "Судьба готовит встречу с тем, кто скажет «ты моя» и заставит забыть все разумные решения."
  ],
  "🐉 Фэнтези": [
    "Твоё предназначение велико. Но сначала выпей чай и дочитай главу.",
    "Скоро в твою жизнь ворвётся магия. Надеемся, без драконов на кухне.",
    "Ты сильнее, чем думаешь. Даже если сегодня твой главный подвиг — встать с кровати."
  ],
  "🌙 Мистика": [
    "Вселенная пытается тебе что-то сказать. Возможно, это «купи ещё одну книгу».",
    "Скоро раскроется тайна. Но не пытайся гуглить концовку своей жизни.",
    "Доверься интуиции. Особенно если она подсказывает отменить планы и читать."
  ],
  "📚 Книжный хаос": [
    "Тебе срочно нужна новая книга. Нет, стопка непрочитанного не считается.",
    "Сегодня ты начнёшь одну главу и внезапно обнаружишь, что уже три часа ночи.",
    "Твой книжный вайб сегодня: купить пять книг, прочитать ноль, быть счастливой."
  ]
}

export function registerCommands(bot) {
  bot.command("start", (ctx) =>
    ctx.reply(
      "🔮 Добро пожаловать в Книжный оракул!\n\nВыбери свой жанр — и я открою твоё книжное предсказание. Осторожно: иногда они подозрительно точные 😏",
      {
        reply_markup: new InlineKeyboard()
          .text("🖤 Дарк-романтика", "dark").row()
          .text("🐉 Фэнтези", "fantasy").row()
          .text("🌙 Мистика", "mystic").row()
          .text("📚 Книжный хаос", "chaos")
      }
    )
  )

  bot.command("help", (ctx) =>
    ctx.reply("Нажми /start, выбери жанр и получи своё книжное предсказание 🔮")
  )

  bot.callbackQuery(["dark", "fantasy", "mystic", "chaos"], async (ctx) => {
    const genreMap = {
      dark: "🖤 Дарк-романтика",
      fantasy: "🐉 Фэнтези",
      mystic: "🌙 Мистика",
      chaos: "📚 Книжный хаос"
    }
    const genre = genreMap[ctx.callbackQuery.data]
    const options = predictions[genre]
    const prediction = options[Math.floor(Math.random() * options.length)]
    await ctx.answerCallbackQuery()
    await ctx.reply(`${genre}\n\n🔮 ${prediction}`)
  })
}
